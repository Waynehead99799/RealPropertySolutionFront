# Copy to .env.local for local development.
# NEXT_ENV=local keeps search engines out and is the right value on your machine.
NEXT_ENV=local
NEXT_API_ENDPOINT=https://real-property-solution-back.vercel.app/api

# Optional: canonical site origin
# NEXT_PUBLIC_SITE_URL=https://www.realpropertysolution.in

# Optional tracking (loads only after the visitor accepts cookies)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Optional server-side Meta Conversions API for Lead events
# META_PIXEL_ID=000000000000000
# META_CAPI_TOKEN=
