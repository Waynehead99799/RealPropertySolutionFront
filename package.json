{
  "name": "admin-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./scripts/node-compat.js node_modules/next/dist/bin/next dev -p 3003",
    "build": "node -r ./scripts/node-compat.js node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/node-compat.js node_modules/next/dist/bin/next start -p 3003",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && npm run type-check && npm run prettier",
    "lint:check": "eslint \"**/*.{js,jsx,ts,tsx}\" && npm run type-check && prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "test": "node scripts/smoke-test.js",
    "prepare:husky": "husky install"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.4",
    "next": "^12.1.6",
    "postcss": "^8.4.12",
    "prettier": "^2.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.0.23"
  },
  "devDependencies": {
    "@types/node": "^14.14.13",
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.9.1",
    "eslint": "^7.15.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.2.0",
    "husky": "^4.3.7",
    "lint-staged": "^10.5.3",
    "sharp": "^0.35.5",
    "typescript": "^4.1.3"
  },
  "resolutions": {
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --quiet --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
